<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Outer" TargetType="Button">
    <Style.Resources>
      <SolidColorBrush x:Key="N" Color="Red" />
      <Style x:Key="Side" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource N}" />
      </Style>
      <Style x:Key="Inner" TargetType="Border">
        <Style.Resources>
          <SolidColorBrush x:Key="N" Color="Blue" />
          <Style x:Key="Innermost" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource N}" />
          </Style>
        </Style.Resources>
      </Style>
    </Style.Resources>
  </Style>
</ResourceDictionary>
