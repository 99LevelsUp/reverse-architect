<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Acme.Views;assembly=Acme">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
    <ResourceDictionary Source="Missing.xaml" />
    <ResourceDictionary Source="pack://application:,,,/Acme.Themes;component/Colors.xaml" />
    <ResourceDictionary Source="pack://application:,,,/Acme.Gone;component/Colors.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="K" TargetType="Button">
    <Setter Property="Margin" Value="2" />
  </Style>

  <Style TargetType="local:ViewA">
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>

  <ControlTemplate x:Key="ListTemplate" TargetType="{x:Type local:ViewA}">
    <Grid>
      <ListBox x:Name="PART_List" ItemsSource="{Binding Items}" />
    </Grid>
  </ControlTemplate>

  <DataTemplate DataType="{x:Type local:EditorViewModel}">
    <TextBlock Text="{Binding Title}" Foreground="{x:Static local:Palette.Ink}" />
  </DataTemplate>

  <Style x:Key="Derived" TargetType="local:ViewA" BasedOn="{StaticResource {x:Type local:ViewA}}" />

  <SolidColorBrush x:Key="Accent" Color="#FF2050A0" />
</ResourceDictionary>
